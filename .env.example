# Only needed for local test runs -- in GitHub Actions these come from
# repository secrets (Settings -> Secrets and variables -> Actions).

# Free key from https://openrouter.ai/ (used for AI incident diagnosis)
OPENROUTER_API_KEY=

# Your ntfy.sh topic name (pick a long, non-guessable string, no account
# needed -- see README). Example: andy-watchdog-8f2k1x
NTFY_TOPIC=

# Only needed to test the GitHub Issue integration locally. In Actions,
# GITHUB_TOKEN and GITHUB_REPOSITORY are provided automatically.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
